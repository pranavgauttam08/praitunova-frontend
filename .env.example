# Backend API base URL. Defaults to the production Render backend if unset —
# override for local dev against a local Django server, e.g.:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_API_URL=https://praitunova-backend.onrender.com/api

# Public site URL — used for canonical/OG tags, robots.txt and sitemap.xml.
# Update this once a custom domain is attached to the Vercel deployment.
NEXT_PUBLIC_SITE_URL=https://frontend-seven-lemon-46.vercel.app
